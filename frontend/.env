# Frontend Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Backend full origin URL (used for image storage URLs)
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# API path prefix — RELATIVE (goes through Vite proxy to avoid CORS)
# Do NOT put a full URL here. Keep it as /api/v2
VITE_API_BASE_URL=/api/v2

# Admin panel URL — used for /admin redirect
VITE_ADMIN_URL=http://127.0.0.1:8000/admin
