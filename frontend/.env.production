# Frontend Environment Configuration (PRODUCTION)
# ─────────────────────────────────────────────────────────────────────────────
# Backend full origin URL (used for image storage URLs and direct API calls)
VITE_BACKEND_ORIGIN=https://admin.rizikpoint.com/

# API path prefix — MUST be a full URL in production because frontend and backend
# live on different domains. Locally we use a relative path that goes through
# the Vite dev server proxy to avoid CORS.
VITE_API_BASE_URL=https://admin.rizikpoint.com/api/v2

# Admin panel URL — used for /admin redirect
VITE_ADMIN_URL=https://admin.rizikpoint.com/admin/login
# Temporary storefront fallback while the production API CORS headers are deployed.
# A saved admin value of 0 still disables dummy images once settings are reachable.
VITE_DUMMY_PRODUCT_IMAGES_FALLBACK=1
